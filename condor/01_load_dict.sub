#
# /share/dmaziuk/projects/dbloader/__main__.py -c /share/dmaziuk/projects/dbloader/loader.properties --load-only --no-metabolomics --drop-tables
#
# reload dictionary tables. this must run first, before any data loading.
#
# runs on the master webserver rather than the database server.
# `dbloader.egg` is a symlink to the current build (packaging/setup.py names
# the egg after the python it was built with, e.g. dbloader-2.0-py3.12.egg).
# TODO dockerize it sometime?
#

universe = LOCAL
executable   = /usr/bin/python3
arguments    = "/websites/_updaters.prod/dbloader.egg -c /websites/_updaters.prod/dbloader.properties --dictdir $(DICTDIR) --no-dump --no-chemcomps --no-macromolecules --no-metabolomics --no-web"
request_memory = 0
priority     = 0
output       = $(STDOUTFILE)
error        = $(STDERRFILE)
log          = $(LOGFILE)
notification = Always
notify_user  = web@bmrb.wisc.edu
coresize     = 1
transfer_executable = FALSE
should_transfer_files = NO

periodic_remove = (time() - QDate) > 36000

+DBLoaderJob = TRUE
+AccountingGroup = "bmrb"

queue
