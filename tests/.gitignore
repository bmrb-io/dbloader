# generated by build_dict_inputs.sh / make_subset.sh / the golden and
# regression runs: the dictionary distribution, the staged scripts input, the
# dict.*.csv + dictionary.sql, the entry symlink trees and the rendered config.
build/

# The golden dumps themselves are ~15 MB and get rebuilt by golden_*.sh every
# time anyway -- the pg-tmp server does not survive a container restart, so
# there is no run that does not rebuild them.  Only the fingerprints are worth
# committing: they are what regression.sh compares against, and what shows up
# in a diff if a golden ever moves.
golden/*/
