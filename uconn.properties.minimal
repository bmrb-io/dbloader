#
# BMRB production config, minimized -- the tracked template.
#
# Copy to `uconn.properties` and fill in the ETS password.  That copy stays out
# of git (.gitignore covers uconn.properties*, with this template exempted),
# because it is the only file in the deployment holding a plaintext password.
# This one carries an empty password on purpose, so it can be reviewed in a
# diff like any other file.
#
# Everything dbloader can work out for itself is gone.  What is left is only
# what it cannot know: which database, which schema, where the entry archives
# are, and how to reach the ETS tracking database.
#
# [DEFAULT] is inherited by every section below, so the connection is stated
# once instead of six times.  A section overrides whatever differs -- which is
# what [ets] does, since it is a different database on a different server.
#
# Dropped from the old file, and why:
#
#   csstats, software_mapfile, software_authors_mapfile, task_mapfile,
#   [web] ddlfile, [web] csvfiles, [meta] ddlfile, [meta] csvdir
#       These ship in the dbloader checkout, next to the code that loads
#       them, and now default to that copy -- see loader/datafiles.py, and
#       `python loader/datafiles.py -c <config>` to print what a config
#       resolves them to.  Name one here only to point somewhere else; a
#       relative path is taken from the top of the checkout.
#
#       Naming them is not merely redundant, it is a trap: an explicit value
#       wins over the shipped default, so a config still pointing at
#       /projects/BMRB/software/dbloader3/... keeps reading the retired
#       checkout after the code has moved.
#
#   [dictionary] ddlfile
#       Defaults to dictionary.sql, inside the directory given with
#       --dictdir.  Generated by nmr-star-dictionary-scripts, not shipped
#       here, which is why it is named rather than found.
#
#   engine
#       Gone with starobj: one driver now, psycopg2, not configurable.
#       Accepted and ignored if left in.
#
#   password (where empty)
#       An empty value is skipped when the connection is built, so the line
#       says nothing.
#
# `host = localhost` is NOT droppable on a host whose PostgreSQL has no unix
# socket at the default path: with no host, libpq tries
# /var/run/postgresql/.s.PGSQL.5432 and fails there.  Setting it uses TCP.
#

#
# WHERE A RELEASE LANDS IS NOT DECIDED HERE.
#
# --host/--port/--database override [DEFAULT] and every target section (see
# loader/db.py:repoint()), and the pipeline always passes them: updater_dag's
# update_bmrb_db.dag names the target once, in a `VARS ALL_NODES` line, and
# every job takes it from there.  reload_db.py does the same for a rehearsal.
#
# So the values below are the fallback for a hand-run with no --database, and
# they are deliberately NOT production.  A forgotten flag lands in a scratch
# database, or fails to connect -- it does not quietly reload the archive.
# Leave them pointing somewhere harmless.
#
[DEFAULT]
database = bmrbdev
host = localhost
user = bmrb
# read-only user, granted select on each schema after it loads
rouser = web

# Deliberately no `port` here: [ets] inherits everything in this section, and
# a port set for the build database would follow it to the tracking server.

# The dictionary. Loaded first -- it is what says which tables the entries go
# into, so the entry schemas are generated from it.
[dictionary]
schema = dict

# One bmr<ID>/bmr<ID>_3.str per entry. Needs [ets] as well as the files: the
# load cross-checks its file list against the released IDs.
[macromolecules]
schema = macromolecules
entrydir = /projects/BMRB/public/entry_directories/macromolecules

# bms[et]<ID>/bms[et]<ID>.str
[metabolomics]
schema = metabolomics
entrydir = /projects/BMRB/public/entry_directories/metabolomics

# Chem comps are dumped out of a separate database that also holds the
# unreleased ones, and loaded into this one. src* is that source; it is not
# the database being reloaded, so reload_db.py leaves it alone.
#
# srchost is stated rather than left to be inferred. repoint() pins it to
# whatever `host` this section resolves to before applying --host, so that
# moving the target does not drag the source along -- but with `host` coming
# from [DEFAULT] that made the ccdb server an invisible consequence of a line
# forty lines up, and, under condor, of which machine the job landed on. It is
# the same value either way; the point is that it now says so.
#
# `localhost` here means the machine running the loader, NOT the --host the
# release is being written to. If ccdb ever lives somewhere else, or the load
# jobs stop running on the ccdb server, this is the line to change.
[chemcomps]
schema = chemcomps
srcdatabase = ccdb
srchost = localhost
srcuser = bmrb

# Only works if `web` is a schema in the same database as `macromolecules`:
# cs_stats.sql reads the macromolecule tables directly and hardcodes both
# schema names. csstats_outdir redirects the seven `\copy` lines that publish
# the statistics -- unset, they go to /projects/BMRB/public/ftp/... by
# absolute path, which is right in production and fails anywhere else.
# reload_db.py always sets it.
[web]
schema = web

# Per-entry time domain (raw FID) directory, %s for the entry ID; scanned to
# fill web.timedomain_data, which webapi.sql reads.
#
# NOT derivable from `entrydir` above: this is the *private* tree, and the data
# sits beside the entry file rather than under bmr<id>/. It is spelled out here
# because getting it wrong is silent -- every entry simply appears to have no
# time domain data. The loader reports how many entries it found and warns at
# zero; check that on the first run.
#
# Both the scan and webapi.sql run inside the web stage now (job 231), against
# the shadow schemas, rather than in the API reloader after the swap.
timedomain_dir = /projects/BMRB/private/entrydirs/macromolecules/bmr%%s/clean/timedomain_data

[meta]
schema = meta

# The entry tracking database: read-only, on its own server, and NOT the
# database being reloaded -- repoint() leaves this section alone, so --host
# and --database never reach it. Supplies the released-ID list the
# macromolecule load checks against, the processing queue and the BMRB-PDB map.
#
# Every inherited value is overridden here on purpose. The password is plain
# text and there is no indirection for it: fill it in on the deployed
# `uconn.properties` only, never here, and keep that copy mode 0600.
[ets]
database = ETS
host = bmrb-ets.nmrbox.org
user = ets
password =
